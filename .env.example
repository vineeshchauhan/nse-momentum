# Angel One SmartAPI credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Leave blank to hit Angel One directly (default when running on DO)
ANGEL_BASE_URL=

# PostgreSQL
# Use DB_HOST=postgres when running via docker-compose; localhost for local dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading
DB_USER=trading_user
DB_PASSWORD=your_db_password_here

# Email (Gmail app password)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_RECEIVER=recipient@example.com
